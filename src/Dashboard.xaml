<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.modernwpf.com/2019" Background="{DynamicResource PageBg}">
 <Grid.Resources>
  <SolidColorBrush x:Key="PageBg" Color="#0B1017"/>
  <SolidColorBrush x:Key="CardBg" Color="#141D29"/>
  <SolidColorBrush x:Key="CardStroke" Color="#243348"/>
  <SolidColorBrush x:Key="Muted" Color="#9CAFC5"/>
  <SolidColorBrush x:Key="Accent" Color="#58E0BB"/>
  <SolidColorBrush x:Key="PrimaryText" Color="#F0F6FD"/>
  <SolidColorBrush x:Key="SecondaryText" Color="#BCCBDC"/>
  <SolidColorBrush x:Key="AltRowBg" Color="#101822"/>
  <SolidColorBrush x:Key="TableHeaderBg" Color="#182435"/>
  <SolidColorBrush x:Key="Separator" Color="#213044"/>
  <SolidColorBrush x:Key="IconBg" Color="#173C38"/>
  <SolidColorBrush x:Key="StatusBg" Color="#15352F"/>
  <SolidColorBrush x:Key="OnAccent" Color="#08251E"/>
  <SolidColorBrush x:Key="RamColor" Color="#74ABFF"/>
  <SolidColorBrush x:Key="GpuColor" Color="#FBC777"/>
  <SolidColorBrush x:Key="DiskColor" Color="#BD9BFF"/>
  <SolidColorBrush x:Key="FooterBg" Color="#0E1621"/>
  <SolidColorBrush x:Key="GridLine" Color="#263548"/>
  <SolidColorBrush x:Key="ButtonBg" Color="#1B293A"/>
  <SolidColorBrush x:Key="ButtonHover" Color="#293D53"/>
  <SolidColorBrush x:Key="ButtonPressed" Color="#324B65"/>
  <SolidColorBrush x:Key="SelectionBg" Color="#254C4B"/>
  <SolidColorBrush x:Key="AccentHover" Color="#78EACB"/>
  <SolidColorBrush x:Key="AccentPressed" Color="#3AC9A3"/>
  <SolidColorBrush x:Key="WarningText" Color="#FBC777"/>

  <Style x:Key="ActionButton" TargetType="Button">
   <Setter Property="Background" Value="{DynamicResource ButtonBg}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="17,10"/><Setter Property="MinHeight" Value="40"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" SnapsToDevicePixels="True">
     <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonHover}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonPressed}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
   <Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource OnAccent}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" SnapsToDevicePixels="True">
     <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentHover}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentPressed}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>


  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource CardBg}"/><Setter Property="BorderBrush" Value="{DynamicResource CardStroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/></Style>
  <Style x:Key="Title" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="28"/></Style>
  <Style x:Key="Small" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="MetricValue" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="FontSize" Value="40"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,5,0,3"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="Transparent"/><Setter Property="RowBackground" Value="Transparent"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource AltRowBg}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="RowHeight" Value="34"/><Setter Property="FontSize" Value="12"/><Setter Property="SelectionMode" Value="Single"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource TableHeaderBg}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Padding" Value="10,10"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBg}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/></Trigger></Style.Triggers></Style>
  <Style x:Key="MetricProgress" TargetType="ProgressBar"><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track" ClipToBounds="True"><Border Background="{DynamicResource Separator}" CornerRadius="2"/><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Legend" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="16,0,0,0"/></Style>
 </Grid.Resources>
 <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
 <Border BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1" Padding="26,14">
  <Grid><StackPanel Orientation="Horizontal"><Border Width="40" Height="40" Background="{DynamicResource IconBg}" CornerRadius="12" Margin="0,0,13,0" VerticalAlignment="Center"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="PC Monitor" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/><TextBlock Text="Diagnóstico local · histórico para análise" Style="{StaticResource Small}"/></StackPanel></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Style="{StaticResource ActionButton}" x:Name="HelpButton" Content="Ajuda" Padding="15,10" Margin="0,0,10,0" ToolTip="Entenda o programa e a análise · F1"/><Button Style="{StaticResource ActionButton}" x:Name="ThemeButton" Content="☀  Modo claro" Padding="14,10" Margin="0,0,10,0" ToolTip="Alternar entre tema claro e escuro"/><Button Style="{StaticResource ActionButton}" x:Name="PauseButton" Content="Pausar coleta" Padding="17,10" Margin="0,0,10,0"/><Button Style="{StaticResource ActionButton}" x:Name="MarkButton" Content="Marcar travamento" Padding="17,10" Margin="0,0,10,0"/><Button Style="{StaticResource PrimaryButton}" x:Name="ExportButton" Content="Exportar diagnóstico" Padding="18,10"/></StackPanel>
  </Grid>
 </Border>
 <ui:NavigationView x:Name="Navigation" Grid.Row="1" IsSettingsVisible="False" IsPaneToggleButtonVisible="False" IsBackButtonVisible="Collapsed" PaneDisplayMode="Left" IsPaneOpen="True" OpenPaneLength="208" CompactPaneLength="58" AlwaysShowHeader="False" PaneTitle="Monitor" Background="{DynamicResource PageBg}">
  <ui:NavigationView.MenuItems>
   <ui:NavigationViewItem x:Name="NavOverview" Content="Visão geral" Tag="Overview"><ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Home"/></ui:NavigationViewItem.Icon></ui:NavigationViewItem>
   <ui:NavigationViewItem Content="Alertas e marcadores" Tag="Incidents"><ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Flag"/></ui:NavigationViewItem.Icon></ui:NavigationViewItem>
   <ui:NavigationViewItem Content="Eventos do Windows" Tag="Events"><ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Document"/></ui:NavigationViewItem.Icon></ui:NavigationViewItem>
   <ui:NavigationViewItem Content="Conexão com IA" Tag="Connection"><ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Link"/></ui:NavigationViewItem.Icon></ui:NavigationViewItem>
   <ui:NavigationViewItem Content="Preferências" Tag="Settings"><ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Setting"/></ui:NavigationViewItem.Icon></ui:NavigationViewItem>
   <ui:NavigationViewItem x:Name="NavHelp" Content="Ajuda" Tag="Help"><ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Help"/></ui:NavigationViewItem.Icon></ui:NavigationViewItem>
  </ui:NavigationView.MenuItems>
  <ui:NavigationView.PaneFooter><StackPanel Margin="18,12,10,22"><TextBlock Text="●  SOMENTE NESTE PC" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Versão 2.0.2" Margin="0,5,0,0" Style="{StaticResource Small}"/></StackPanel></ui:NavigationView.PaneFooter>
  <Grid Margin="22,10,24,18">
   <Grid x:Name="OverviewPage">
    <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="148"/><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="205"/></Grid.RowDefinitions>
    <Grid><StackPanel><TextBlock Text="Visão geral" Style="{StaticResource Title}"/><TextBlock Text="Acompanhe o computador e registre o contexto de uma falha." Style="{StaticResource Small}" Margin="0,5,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource StatusBg}" CornerRadius="14" Padding="12,6" Margin="0,8,0,0"><TextBlock x:Name="StateText" Text="●  Preparando coleta" Foreground="{DynamicResource Accent}" FontSize="12"/></Border></Grid>
    <UniformGrid Grid.Row="1" Columns="4">
     <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="PROCESSADOR" Style="{StaticResource Small}"/><TextBlock x:Name="CpuValue" Text="—" Style="{StaticResource MetricValue}"/><TextBlock x:Name="CpuDetail" Text="Aguardando leitura" Style="{StaticResource Small}"/><ProgressBar Style="{StaticResource MetricProgress}" x:Name="CpuBar" Height="4" Margin="0,16,0,0" Foreground="{DynamicResource Accent}" Maximum="100"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="MEMÓRIA RAM" Style="{StaticResource Small}"/><TextBlock x:Name="RamValue" Text="—" Style="{StaticResource MetricValue}"/><TextBlock x:Name="RamDetail" Text="Aguardando leitura" Style="{StaticResource Small}"/><ProgressBar Style="{StaticResource MetricProgress}" x:Name="RamBar" Height="4" Margin="0,16,0,0" Foreground="{DynamicResource RamColor}" Maximum="100"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="PLACA DE VÍDEO" Style="{StaticResource Small}"/><TextBlock x:Name="GpuValue" Text="—" Style="{StaticResource MetricValue}"/><TextBlock x:Name="GpuDetail" Text="Aguardando NVIDIA" Style="{StaticResource Small}"/><ProgressBar Style="{StaticResource MetricProgress}" x:Name="GpuBar" Height="4" Margin="0,16,0,0" Foreground="{DynamicResource GpuColor}" Maximum="100"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ATIVIDADE DO DISCO" Style="{StaticResource Small}"/><TextBlock x:Name="DiskValue" Text="—" Style="{StaticResource MetricValue}"/><TextBlock x:Name="DiskDetail" Text="Preparando consulta" Style="{StaticResource Small}"/><ProgressBar Style="{StaticResource MetricProgress}" x:Name="DiskBar" Height="4" Margin="0,16,0,0" Foreground="{DynamicResource DiskColor}" Maximum="100"/></StackPanel></Border>
    </UniformGrid>
    <DockPanel Grid.Row="2" VerticalAlignment="Center"><TextBlock x:Name="NetworkText" Style="{StaticResource Small}" Text="Rede: aguardando"/><TextBlock x:Name="GpuNameText" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource Small}"/></DockPanel>
    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14"><Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock Text="Histórico de utilização" Foreground="{DynamicResource PrimaryText}" FontSize="14" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="● CPU" Foreground="{DynamicResource Accent}" Style="{StaticResource Legend}"/><TextBlock Text="● RAM" Foreground="{DynamicResource RamColor}" Style="{StaticResource Legend}"/><TextBlock Text="● GPU" Foreground="{DynamicResource GpuColor}" Style="{StaticResource Legend}"/><TextBlock Text="● Disco" Foreground="{DynamicResource DiskColor}" Style="{StaticResource Legend}"/></StackPanel></DockPanel><Grid x:Name="ChartHost" Grid.Row="1"/></Grid></Border>
    <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,14,0"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Maiores consumidores" Foreground="{DynamicResource PrimaryText}" FontSize="14" FontWeight="SemiBold"/><DataGrid x:Name="ProcessesGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Processo" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="65"/><DataGridTextColumn Header="RAM" Binding="{Binding Memory}" Width="85"/></DataGrid.Columns></DataGrid></Grid></Border>
     <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,12"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Espaço disponível" Foreground="{DynamicResource PrimaryText}" FontSize="14" FontWeight="SemiBold"/><DataGrid x:Name="VolumesGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Volume" Binding="{Binding Drive}" Width="*"/><DataGridTextColumn Header="Livre" Binding="{Binding Free}" Width="85"/><DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="80"/></DataGrid.Columns></DataGrid></Grid></Border>
    </Grid>
   </Grid>
   <Grid x:Name="IncidentsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Alertas e marcadores" Style="{StaticResource Title}"/><TextBlock Text="Registros recentes, incluindo horários marcados por você ou pelo chat." Style="{StaticResource Small}" Margin="0,8,0,0"/></StackPanel><Border Grid.Row="1" Style="{StaticResource Card}" Padding="12"><DataGrid x:Name="IncidentsGrid"><DataGrid.Columns><DataGridTextColumn Header="Horário" Binding="{Binding Time}" Width="135"/><DataGridTextColumn Header="Nível" Binding="{Binding Level}" Width="90"/><DataGridTextColumn Header="Registro" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid></Border></Grid>
   <Grid x:Name="EventsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="95"/><RowDefinition Height="3*"/><RowDefinition Height="2*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Eventos do Windows" Style="{StaticResource Title}"/><TextBlock x:Name="EventStateText" Text="Aguardando consulta dos canais System e Application" Style="{StaticResource Small}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel><Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12"><DataGrid x:Name="EventsGrid"><DataGrid.Columns><DataGridTextColumn Header="Horário" Binding="{Binding Time}" Width="130"/><DataGridTextColumn Header="Origem" Binding="{Binding Provider}" Width="*"/><DataGridTextColumn Header="ID" Binding="{Binding EventId}" Width="65"/><DataGridTextColumn Header="Nível" Binding="{Binding Level}" Width="85"/></DataGrid.Columns></DataGrid></Border><Border Grid.Row="2" Style="{StaticResource Card}" Padding="16"><TextBox x:Name="EventDetails" Text="Selecione um evento para ler a descrição completa." IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="12"/></Border></Grid>
   <ScrollViewer x:Name="ConnectionPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Conexão com IA" Style="{StaticResource Title}"/><TextBlock Text="Consulte este computador pelo chat e correlacione métricas com falhas." Style="{StaticResource Small}" Margin="0,8,0,24"/>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Comunicação local" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/><TextBlock x:Name="BridgeStateText" Text="Preparando conexão…" Margin="0,10,0,6" Foreground="{DynamicResource Accent}"/><TextBlock x:Name="BridgeLastText" Text="Nenhuma consulta recebida nesta execução." Style="{StaticResource Small}"/><TextBlock Text="O servidor MCP permite consultar métricas, histórico, eventos e informações do sistema. Um marcador de travamento pode ser registrado quando você pedir." TextWrapping="Wrap" Margin="0,16,0,0" Foreground="{DynamicResource SecondaryText}"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Experimente no chat" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/><TextBlock Text="• Como está o computador agora?&#10;• Analise os últimos 15 minutos.&#10;• O LoL travou há pouco; compare métricas e eventos.&#10;• Marque um travamento agora." TextWrapping="Wrap" LineHeight="28" Margin="0,12,0,0" Foreground="{DynamicResource SecondaryText}"/><TextBlock Text="A skill pc-monitor orienta a análise. A conexão do Codex pode precisar ser recarregada após a primeira instalação." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,15,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Privacidade e alcance" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/><TextBlock Text="Os dados ficam neste computador até você pedir uma consulta no chat ou exportar um pacote. Logs podem conter informações pessoais; a ocultação de segredos é parcial. O MCP não instala drivers, não desinstala programas e não executa comandos arbitrários." TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource SecondaryText}"/></StackPanel></Border>
   </StackPanel></ScrollViewer>
   <Grid x:Name="HelpPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,14"><TextBlock Text="Ajuda e funcionamento" Style="{StaticResource Title}"/><TextBlock Text="Entenda as métricas, os alertas e como investigar uma falha." Style="{StaticResource Small}" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16"><Button x:Name="ExpandHelpButton" Content="Expandir tudo" Style="{StaticResource ActionButton}" Margin="0,0,10,0"/><Button x:Name="CollapseHelpButton" Content="Recolher tudo" Style="{StaticResource ActionButton}"/><TextBlock Text="F1 abre esta ajuda" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="16,0,0,0"/></StackPanel>
    <ScrollViewer x:Name="HelpScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,0"><StackPanel x:Name="HelpTopicsPanel"><Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,12"><Expander x:Name="HelpTopic0" Header="Comece por aqui" IsExpanded="True" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"><StackPanel Margin="6,0,6,8"><TextBlock Text="Para que serve" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="O PC Monitor acompanha o uso dos recursos do computador e guarda um histórico local para investigar lentidão, travamentos e erros. Ele registra sinais do problema; não impede travamentos nem corrige o Windows automaticamente." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Onde encontrar cada informação" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Visão geral mostra métricas e o gráfico recente. Alertas e marcadores reúne avisos e horários registrados por você. Eventos do Windows exibe erros e avisos coletados; selecione uma linha para ler a descrição. Conexão com IA informa o estado da comunicação local. Preferências controla aparência, início com Windows e registros." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Janela e bandeja" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Fechar ou minimizar a janela mantém a coleta na bandeja, perto do relógio do Windows. Dê dois cliques no ícone para abrir o painel ou use o menu do botão direito. Para encerrar a coleta e o programa, escolha Sair do PC Monitor nesse menu. Iniciar com o Windows abre o monitor recolhido ao entrar na sua conta." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /></StackPanel></Expander></Border><Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,12"><Expander x:Name="HelpTopic1" Header="Entenda as métricas" IsExpanded="False" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"><StackPanel Margin="6,0,6,8"><TextBlock Text="Processador (CPU)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Mostra o uso total dos processadores lógicos, de 0 a 100%. Um núcleo pode estar ocupado mesmo com a média total baixa. A leitura não mede FPS ou desempenho de um jogo diretamente." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Memória RAM" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Mostra a parcela da memória física em uso e os valores usados/total. Uso alto pode causar pressão de memória, mas o percentual isolado não comprova defeito na RAM." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Placa de vídeo (GPU)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Em placas NVIDIA compatíveis, consulta utilização, temperatura, memória de vídeo (VRAM), potência e versão do driver disponíveis. O painel mostra os principais valores; os demais ficam nos registros. A coleta usa a primeira GPU retornada pela ferramenta NVIDIA. Sensores de outras marcas não são coletados nesta versão. Uso alto de GPU durante um jogo pode ser normal." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Disco e espaço disponível" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Atividade do disco é o maior percentual de ocupação entre os discos físicos acessíveis, acompanhado das taxas de leitura e gravação. Não é uma medida da saúde do SSD/HD. A tabela de volumes mostra espaço livre e capacidade, que são informações diferentes da atividade." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Rede" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="As setas indicam dados recebidos e enviados por segundo. B, KB, MB e GB representam quantidades de dados; /s significa por segundo. Os totais somam interfaces ativas e podem duplicar tráfego de VPN ou adaptadores virtuais. Não há teste de velocidade da internet, ping ou perda de pacotes." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Maiores consumidores" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Agrupa processos com o mesmo nome e soma seus valores. O número entre parênteses indica quantas instâncias existem. A seleção reúne os oito maiores consumidores de RAM e os cinco de CPU, sem repetir nomes; a tabela é ordenada por RAM. CPU por processo é normalizada pela capacidade total da máquina. Processos protegidos podem ter leituras incompletas." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Traço (—) ou valor ausente" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Significa que a leitura está indisponível, ainda está sendo preparada ou ficou antiga; não significa zero. A GPU possui horário próprio, e uma leitura com 30 segundos ou mais deixa de ser tratada como atual no painel." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /></StackPanel></Expander></Border><Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,12"><Expander x:Name="HelpTopic2" Header="Frequência de coleta e gráfico" IsExpanded="False" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"><StackPanel Margin="6,0,6,8"><TextBlock Text="Quando os dados mudam" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Por padrão, os recursos gerais são amostrados a cada 2 segundos. Processos são renovados aproximadamente a cada 5 segundos, GPU a cada 10, eventos do Windows a cada 15 e espaço dos volumes a cada 30. Os trabalhos seguem o ritmo das amostras; esses intervalos podem aumentar se o computador estiver ocupado." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Gráfico recente e histórico gravado" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="O gráfico mantém até 180 amostras e tenta carregar leituras dos últimos 6 minutos ao abrir. Não representa todo o histórico em disco. Gravar a cada, em Preferências, define o intervalo de gravação das métricas, de 2 a 60 segundos; não transforma a coleta em uma captura por quadro do jogo." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Pausar e retomar" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Pausar coleta interrompe novas amostras e novas consultas periódicas enquanto o programa permanece aberto. O botão muda para Retomar coleta. Os registros anteriores continuam disponíveis. Sono do Windows, pausa, fechamento do programa ou falhas podem deixar lacunas; lacuna não é uso zero." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /></StackPanel></Expander></Border><Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,12"><Expander x:Name="HelpTopic3" Header="Como os alertas automáticos são calculados" IsExpanded="False" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"><StackPanel Margin="6,0,6,8"><TextBlock Text="Regras locais" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="O monitor compara as amostras com limites fixos. São alertas por regras, não uma IA executando em segundo plano. Os limites abaixo são indícios gerais; não se ajustam automaticamente ao seu hardware ou ao jogo." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="CPU e RAM" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Gera um aviso quando CPU ou RAM fica em 90% ou mais durante pelo menos 20 segundos, conforme as amostras disponíveis." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Atividade de disco" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Gera um aviso quando a atividade fica em 95% ou mais durante pelo menos 20 segundos." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Temperatura da GPU" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Gera um aviso com leitura NVIDIA válida e recente em 85 °C ou mais por pelo menos 15 segundos. A adequação dessa temperatura depende do modelo e das condições de uso; o aviso não confirma superaquecimento ou dano." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Pouco espaço" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Gera um aviso quando algum volume tem menos de 10% de espaço livre. Não exige os 20 segundos das regras anteriores." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Repetição e falhas de coleta" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Os avisos de limite se repetem no máximo uma vez a cada 5 minutos por categoria. Quando a condição deixa de ocorrer, a contagem de duração é reiniciada. O programa também registra intervalos de amostragem maiores que o esperado, falhas ao coletar/gravar e uma execução anterior sem encerramento registrado. Esses registros não provam que o computador inteiro travou." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /></StackPanel></Expander></Border><Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,12"><Expander x:Name="HelpTopic4" Header="Eventos, marcadores e estados do monitor" IsExpanded="False" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"><StackPanel Margin="6,0,6,8"><TextBlock Text="Eventos do Windows" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="São mensagens produzidas pelo Windows e por aplicativos nos canais System e Application. O monitor coleta eventos críticos e erros, além de avisos de provedores relevantes para disco, memória, vídeo, energia e falhas de aplicativos. Não copia todos os canais nem todos os logs dos jogos. A leitura é feita em lotes e pode ter atraso." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Eventos anteriores" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="No primeiro acesso, busca uma janela de até 2 horas. Ao retomar com um cursor existente, pode recuperar eventos ainda não lidos de até 7 dias. O horário do evento pode ser anterior ao horário em que ele foi coletado." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Marcador de travamento" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Marcar travamento grava um horário e sua observação. Informe jogo, sintoma, duração e horário aproximado, especialmente se o computador só respondeu depois. É um relato seu, não uma falha detectada automaticamente." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Mensagens no painel" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Monitorando indica que a coleta está ativa; não certifica a saúde do hardware. Coleta pausada significa pausa manual. Leituras parciais indica falta de alguma leitura acompanhada pelo painel. Coleta atrasada indica ausência de atualização recente. Falha na coleta indica erro reportado pelo coletor ou pela gravação. Veja também o rodapé e os eventos para obter contexto." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /></StackPanel></Expander></Border><Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,12"><Expander x:Name="HelpTopic5" Header="Como a análise pela IA funciona" IsExpanded="False" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"><StackPanel Margin="6,0,6,8"><TextBlock Text="Coletar e interpretar são etapas diferentes" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="O aplicativo registra métricas, eventos e alertas locais. A interpretação pela IA acontece no chat quando você pede uma análise e a integração está disponível. O monitor não envia continuamente seus registros para uma IA e não executa uma análise de linguagem sozinho." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="O que deve ser comparado" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="A análise começa verificando se o monitor está online, a idade dos dados e quais sensores estão disponíveis. Em seguida, compara a janela antes e depois do horário relatado: recursos, maiores consumidores, alertas, marcadores e eventos concretos do Windows." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Como chegar a uma hipótese" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Picos sustentados, mudança no consumo e eventos no mesmo horário ajudam a formular hipóteses. Coincidência de horário não prova causa. Uma boa análise separa fatos confirmados, hipóteses e dados ausentes, e propõe verificações proporcionais ao que foi encontrado." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Cobertura e incerteza" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="O histórico consultado pode ser resumido e a leitura é limitada. A IA deve informar a janela realmente retornada, lacunas e sensores ausentes. Uma média baixa não descarta um pico curto ou a saturação de um núcleo. Se houver só registros antigos, eles não devem ser apresentados como o estado atual do PC." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /></StackPanel></Expander></Border><Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,12"><Expander x:Name="HelpTopic6" Header="Passo a passo quando um jogo trava" IsExpanded="False" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"><StackPanel Margin="6,0,6,8"><TextBlock Text="1 · Deixe o monitor aberto" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Mantenha a coleta ativa antes de iniciar o jogo. A bandeja permite acompanhar sem deixar a janela sobre o jogo." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="2 · Registre o contexto" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Quando o computador responder, clique em Marcar travamento e descreva o que ocorreu: jogo congelou, tela preta, áudio continuou, computador reiniciou ou somente o jogo fechou. Inclua o horário aproximado e quanto tempo durou. O horário do marcador será o da gravação; descreva o horário anterior se necessário." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="3 · Peça uma comparação no chat" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Exemplo: Use $pc-monitor para analisar os 15 minutos ao redor do travamento do LoL às 21h30. Compare métricas, marcadores e eventos, separando fatos de hipóteses. Informe o dia se o episódio não foi hoje." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="4 · Exporte se precisar" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Use Exportar diagnóstico para salvar um pacote local e compartilhar manualmente. Se o monitor não estava ativo ou a coleta parou, parte do episódio pode não ter métricas; alguns eventos do Windows ainda podem estar disponíveis depois." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /></StackPanel></Expander></Border><Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,12"><Expander x:Name="HelpTopic7" Header="Conexão com IA: MCP e skill" IsExpanded="False" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"><StackPanel Margin="6,0,6,8"><TextBlock Text="O que é a conexão" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="O servidor MCP é a ponte local entre o chat e o monitor. A skill pc-monitor orienta como consultar e interpretar os dados. A página Conexão com IA mostra se o canal local está pronto e a última consulta recebida; isso, sozinho, não confirma que este chat já carregou a integração." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="O que o chat pode consultar" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Há consultas de status, métricas atuais, histórico, eventos, incidentes/marcadores e informações básicas do sistema. Quando você pedir, também pode registrar um marcador. Exemplos: Como está o computador agora? ou Use $pc-monitor para analisar os últimos 15 minutos." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Monitor fechado ou dados antigos" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Consultas de leitura podem usar registros existentes e informar que a fonte é histórica. Registrar um marcador exige o monitor ativo. Se a integração acabou de ser instalada e ainda não aparecer no chat, pode ser necessário reabrir o Codex." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Alcance das ferramentas" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="A comunicação local é restrita à sua conta. As ferramentas do monitor não oferecem instalação de drivers, desinstalação de programas, reinício do computador nem execução de comandos arbitrários. O monitor não faz um inventário completo de drivers." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /></StackPanel></Expander></Border><Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,12"><Expander x:Name="HelpTopic8" Header="Preferências, temas e atalhos" IsExpanded="False" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"><StackPanel Margin="6,0,6,8"><TextBlock Text="Aparência" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Escolha Claro ou Escuro em Preferências &gt; Aparência, ou use o botão no topo. A alteração é aplicada e salva imediatamente, inclusive para a próxima inicialização." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Iniciar com o Windows" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="O interruptor salva a alteração imediatamente para sua conta. Ao entrar no Windows, o programa aguarda 30 segundos e inicia somente na bandeja, sem mostrar o painel. Ele não se instala como um serviço administrativo nem eleva as permissões automaticamente." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Coleta e retenção" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Ajuste o intervalo de gravação, os dias de retenção, o limite de espaço e a coleta de processos, eventos e GPU NVIDIA. Para aplicar essas opções, clique em Salvar preferências. Desativar uma fonte limita o que pode ser analisado depois." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Ajuda" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Abra pelo botão Ajuda no topo, pela navegação lateral, pelo menu da bandeja ou pela tecla F1 quando o painel estiver em foco. Clique no título de um tópico para abrir/fechar seu conteúdo. Expandir tudo e Recolher tudo facilitam a leitura. A Ajuda funciona sem internet." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /></StackPanel></Expander></Border><Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,12"><Expander x:Name="HelpTopic9" Header="Registros, retenção e exportação" IsExpanded="False" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"><StackPanel Margin="6,0,6,8"><TextBlock Text="Onde ficam os dados" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="A pasta padrão é %LOCALAPPDATA%\PCMonitor. Em Preferências, Abrir pasta de dados mostra a pasta usada por esta execução. Os arquivos diários guardam métricas, incidentes e eventos; há também informações básicas do sistema, preferências e controles de sessão/leitura." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Quanto tempo são mantidos" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="O padrão é manter logs por até 7 dias ou 200 MB, o primeiro limite atingido. É possível escolher de 1 a 30 dias e de 25 a 1000 MB. A limpeza remove logs antigos; o limite é aplicado à pasta de logs, não a toda a pasta do aplicativo. Pacotes ZIP já exportados não são apagados por essa rotina." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Horários e formato" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="O painel apresenta horários locais. Os registros usam horário UTC e um identificador de sessão para relacionar as leituras. Arquivos JSONL contêm um registro por linha, permitindo consultar o histórico sem depender da janela aberta." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="O que vai no pacote" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Exportar diagnóstico cria um ZIP na pasta que você escolher, com guia de análise, manifesto, informações básicas do sistema, métricas atuais disponíveis e logs existentes. Ele não envia o arquivo automaticamente. Revise as mensagens antes de compartilhar, pois podem conter dados pessoais." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /></StackPanel></Expander></Border><Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,12"><Expander x:Name="HelpTopic10" Header="Privacidade, limitações e cuidados na interpretação" IsExpanded="False" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"><StackPanel Margin="6,0,6,8"><TextBlock Text="O que é registrado" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="São coletados números de utilização, nomes e contagem de processos selecionados, eventos relevantes e observações que você digitar. Não há captura de tela, teclas, conteúdo de abas ou argumentos dos processos. Dados como IP ou MAC não são coletados deliberadamente, mas mensagens de terceiros podem conter informações pessoais." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Ocultação parcial" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="O programa tenta ocultar caminhos de perfil e alguns padrões de segredos. Isso não garante a remoção de todos os dados pessoais. Os dados ficam locais até uma consulta solicitada pelo chat ou uma exportação compartilhada por você; o conteúdo consultado pode passar a fazer parte da conversa." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="O que esta versão não mede" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Não mede temperatura da CPU, saúde SMART dos discos, FPS por quadro, integridade física da RAM ou todos os drivers instalados. Não analisa minidumps e não captura automaticamente todos os arquivos de log dos jogos. Também não executa teste físico ou teste de estresse." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Permissões e sensores" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Alguns processos ou canais de eventos podem estar inacessíveis à conta atual. A ausência de um sensor ou uma falha de leitura não demonstra defeito da peça. Uma execução encerrada sem registro pode ser término forçado, reinício, falta de energia ou falha do próprio monitor." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /><TextBlock Text="Antes de concluir uma causa" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,14,0,4"/><TextBlock Text="Avisos de recurso, eventos e relatos precisam ser comparados no mesmo horário. Um erro antigo não explica necessariamente um travamento recente. O monitor ajuda a reunir evidências; quando os dados não bastam, a conclusão correta deve indicar essa limitação." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryText}" /></StackPanel></Expander></Border></StackPanel><Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="Dados desta instalação" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/><TextBlock x:Name="HelpConfigText" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" LineHeight="22" Margin="0,12,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
   </Grid>
   <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="850" HorizontalAlignment="Left"><TextBlock Text="Preferências" Style="{StaticResource Title}"/><TextBlock Text="Personalize a aparência, o início automático e os registros." Style="{StaticResource Small}" Margin="0,8,0,22"/>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,24,0"><TextBlock Text="Aparência" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/><TextBlock Text="Escolha o tema. A mudança é imediata e sua preferência fica salva." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel><ComboBox x:Name="ThemePicker" Grid.Column="1" VerticalAlignment="Center" MinHeight="38" ToolTip="Tema da interface"><ComboBoxItem Content="Escuro"/><ComboBoxItem Content="Claro"/></ComboBox></Grid></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><ui:ToggleSwitch x:Name="StartupToggle" Header="Iniciar com o Windows" OnContent="Ativado · iniciar na bandeja" OffContent="Desativado"/><TextBlock Text="A opção vale para sua conta e mantém a janela recolhida ao entrar no Windows." Style="{StaticResource Small}" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Coleta e retenção" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,16"/><UniformGrid Columns="3"><StackPanel Margin="0,0,14,0"><TextBlock Text="Gravar a cada (segundos)" Style="{StaticResource Small}"/><ui:NumberBox x:Name="LogInterval" Minimum="2" Maximum="60" SmallChange="1" Value="2" Margin="0,8,0,0"/></StackPanel><StackPanel Margin="0,0,14,0"><TextBlock Text="Manter por até (dias)" Style="{StaticResource Small}"/><ui:NumberBox x:Name="Retention" Minimum="1" Maximum="30" SmallChange="1" Value="7" Margin="0,8,0,0"/></StackPanel><StackPanel><TextBlock Text="Limite de logs (MB)" Style="{StaticResource Small}"/><ui:NumberBox x:Name="MaxSize" Minimum="25" Maximum="1000" SmallChange="25" Value="200" Margin="0,8,0,0"/></StackPanel></UniformGrid><ui:ToggleSwitch x:Name="ProcessToggle" Header="Maiores consumidores de CPU e RAM" Margin="0,20,0,12"/><ui:ToggleSwitch x:Name="EventToggle" Header="Erros e avisos relevantes do Windows" Margin="0,0,0,12"/><ui:ToggleSwitch x:Name="GpuToggle" Header="Métricas NVIDIA"/><StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Button Style="{StaticResource PrimaryButton}" x:Name="SaveSettingsButton" Content="Salvar preferências" Padding="18,10" Margin="0,0,10,0"/><Button Style="{StaticResource ActionButton}" x:Name="OpenDataButton" Content="Abrir pasta de dados" Padding="18,10"/></StackPanel><TextBlock x:Name="SettingsResultText" Margin="0,12,0,0" Foreground="{DynamicResource Accent}" TextWrapping="Wrap"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Limites da coleta" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/><TextBlock Text="Temperatura da CPU e saúde SMART não são medidas nesta versão. A coleta não substitui teste de memória, análise de minidump ou teste físico. Valores indisponíveis aparecem como —. Alertas são indícios e precisam ser comparados com o horário do problema.&#10;&#10;Os logs mais antigos são removidos ao atingir o limite de dias ou espaço. Pacotes ZIP exportados são mantidos separadamente." Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock x:Name="DataPathText" Style="{StaticResource Small}" Margin="0,16,0,0" TextWrapping="Wrap"/></StackPanel></Border>
   </StackPanel></ScrollViewer>
  </Grid>
 </ui:NavigationView>
